# Copy to a secure location outside the repository, fill in the values, and:
#   set -a; source /secure/path/swarm.env; set +a
#   ./scripts/deploy-swarm.sh

# Public DNS name whose A record points to a Swarm node.
DOMAIN=splitmate.example.com

# Use an immutable tag (preferably the Git commit SHA), not `latest`.
API_IMAGE=ghcr.io/geoffkylin1/ece-1779-project:replace-with-git-sha

# Caddy + frontend image built from deploy/caddy/Dockerfile (same tag rule).
CADDY_IMAGE=ghcr.io/geoffkylin1/ece-1779-project-caddy:replace-with-git-sha
