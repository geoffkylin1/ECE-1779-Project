# Copy this file to .env for local development. Never commit .env.

# Application
APP_ENV=development
DEBUG=false
HTTP_PORT=8080
SITE_ADDRESS=:80
JWT_SECRET_KEY=local-development-only-change-me

# PostgreSQL
POSTGRES_DB=splitmate
POSTGRES_USER=splitmate
POSTGRES_PASSWORD=splitmate_dev_password

# Used when running the backend directly outside Docker Compose
DATABASE_URL=postgresql+psycopg://splitmate:splitmate_dev_password@localhost:5432/splitmate