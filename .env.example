# Copy this file to .env and fill in real values:
#   cp .env.example .env
# NEVER commit your .env file.

# Application
APP_ENV=development
APP_PORT=8000
DEBUG=true

# Cloud credentials (fill in if needed)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_DEFAULT_REGION=us-east-1

# Database
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ece1779

# Third-party APIs
API_KEY=your-api-key

# JWT authentication (set a strong random secret in .env)
JWT_SECRET_KEY=replace-with-a-secure-random-secret
